# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ── Application ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-min-32-bytes
APP_ENV=production
# Comma-separated allowed origins, e.g. https://app.example.com
CORS_ALLOW_ORIGINS=

# ── PostgreSQL (db service) ─────────────────────────────────────────────────
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=marketplace_db

# App's DB connection string (host "db" = the compose service).
# NOTE: sslmode is intentionally omitted for now. Once the Postgres-TLS task
# lands (server-side TLS enabled), append "?sslmode=require".
DATABASE_URL=postgresql+psycopg2://marketplace:change-me-strong-password@db:5432/marketplace_db
